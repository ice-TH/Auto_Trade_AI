# Application Environment Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data_store/autotrade.db

# Trading Mode: 'READ_ONLY' (Default), 'DEMO', or 'LIVE' (Disabled by default)
TRADING_MODE=READ_ONLY
EXECUTION_ENABLED=false

# Account & Capital Settings
BASE_CAPITAL_THB=3000.0
MAX_LEVERAGE=5.0
RISK_PER_TRADE_PERCENT=2.0
MAX_DAILY_LOSS_PERCENT=5.0

# Market Data Source: 'MOCK' (Default) or 'WEBULL_OPENAPI'
DATA_SOURCE=MOCK
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_ENDPOINT=https://api.webull.com

# MetaTrader 5 Settings (Exness)
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial1
